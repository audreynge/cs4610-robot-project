  <version>0.1.0</version>
  <description>Litter detection and 3D localization for Clean Sweep.</description>
  <maintainer email="noreply@example.com">Clean Sweep Team</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>launch</exec_depend>
